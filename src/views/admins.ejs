<%- include('partials/header', { title: 'Admins', username: username }) %>
<div class="container">
  <div class="page-header">
    <h1>Admin accounts</h1>
  </div>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <div class="card">
    <h2>Add admin</h2>
    <form method="POST" action="/admins" style="display:flex; gap:10px; align-items:flex-end;">
      <div style="flex:1;">
        <label style="margin-top:0;">Username</label>
        <input type="text" name="username" required />
      </div>
      <div style="flex:1;">
        <label style="margin-top:0;">Password</label>
        <input type="password" name="password" required />
      </div>
      <button type="submit" class="btn btn-accent">Add admin</button>
    </form>
  </div>

  <div class="card" style="padding:0;">
    <table>
      <thead>
        <tr>
          <th>Username</th>
          <th>Created</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% admins.forEach((admin) => { %>
          <tr>
            <td>
              <%= admin.username %>
              <% if (admin.id === currentAdminId) { %><span class="muted">(you)</span><% } %>
            </td>
            <td class="mono"><%= admin.created_at %></td>
            <td style="text-align:right; white-space:nowrap;">
              <% if (admin.id !== currentAdminId) { %>
                <form class="inline" method="POST" action="/admins/<%= admin.id %>/delete" onsubmit="return confirm('Remove this admin account?');">
                  <button type="submit" class="btn btn-small btn-danger">Remove</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('partials/footer') %>
