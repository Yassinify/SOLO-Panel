<%- include('partials/header', { title: 'Inbounds', loggedIn: loggedIn, csrfToken: csrfToken }) %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<div class="container">
  <div class="page-header">
    <h1>Inbounds</h1>
  </div>

  <div class="card">
    <div class="page-header" style="margin-bottom:14px;">
      <div>
        <h2 style="margin-bottom:4px;">System <span class="health-badge health-<%= systemStatus %>"><%= systemStatus %></span></h2>
        <p class="muted" style="margin:0;"><%= activeCount %> / <%= totalCount %> endpoints active</p>
      </div>
    </div>
    <p class="muted" style="margin-top:0;">
      Every combination of protocol, transport, ALPN, and TLS
      fingerprint is auto-generated automatically -- nothing to set up.
      All of them ride Railway's single HTTPS domain (<%= externalHost %>:443).
      Open the Subscription Panel link in a browser to see a friendly
      overview, or paste the Subscription URL into your client app to
      import every config at once.
    </p>
    <div>
      <label style="margin-top:0;">Subscription Panel (open in a browser)</label>
      <div class="link-box">
        <code id="sub-all" class="muted" tabindex="0" role="button" aria-label="Copy subscription panel link to clipboard" title="Click to copy" onclick="copyLink('sub-all')"><%= subLink %></code>
        <button type="button" class="btn btn-small qr-icon-btn" title="Show QR" aria-label="Show QR code for subscription panel link" onclick="showQr('sub-all')"><%- qrIconSvg %></button>
      </div>
      <label>Subscription URL (paste into client apps)</label>
      <div class="link-box">
        <code id="sub-raw" class="muted" tabindex="0" role="button" aria-label="Copy raw subscription URL to clipboard" title="Click to copy" onclick="copyLink('sub-raw')"><%= subLink %>/raw</code>
        <button type="button" class="btn btn-small qr-icon-btn" title="Show QR" aria-label="Show QR code for raw subscription URL" onclick="showQr('sub-raw')"><%- qrIconSvg %></button>
      </div>
    </div>
  </div>

  <details class="card">
    <summary class="muted" style="cursor:pointer; font-weight:600;">Advanced: per-endpoint technical detail (<%= inbounds.length %>)</summary>
    <% inbounds.forEach((inbound) => { %>
        <div class="card" style="margin-top:14px;">
          <div class="page-header" style="margin-bottom:14px;">
            <div>
              <h2 style="margin-bottom:4px;"><%= inbound.label %> <span class="health-badge health-<%= inbound.health.status %>"><%= inbound.health.status %></span></h2>
              <p class="muted" style="margin:0;">
                path=<%= inbound.path %> - internal port <%= inbound.internalPort %> - <%= inbound.links.length %> link variants
                <% if (inbound.health.latencyMs !== null && inbound.health.latencyMs !== undefined) { %> - <%= inbound.health.latencyMs %>ms<% } %>
              </p>
            </div>
          </div>

          <details>
            <summary class="muted" style="cursor:pointer;">Show all link variants</summary>
            <% inbound.links.forEach((link, idx) => { %>
              <div class="link-box" style="margin-top:10px;">
                <code id="link-<%= inbound.id %>-<%= idx %>" tabindex="0" role="button" aria-label="Copy link to clipboard" title="Click to copy" onclick="copyLink('link-<%= inbound.id %>-<%= idx %>')"><%= link %></code>
                <button type="button" class="btn btn-small qr-icon-btn" title="Show QR" aria-label="Show QR code for this link" onclick="showQr('link-<%= inbound.id %>-<%= idx %>')"><%- qrIconSvg %></button>
              </div>
            <% }) %>
          </details>

          <p class="muted mono" style="margin-top:10px; margin-bottom:0;">&uarr;<%= formatBytes(inbound.up_bytes) %> &darr;<%= formatBytes(inbound.down_bytes) %></p>
        </div>
    <% }) %>
  </details>
</div>

<div class="modal-backdrop" id="qr-modal" onclick="if(event.target===this) closeQr()">
  <div class="modal-box">
    <h3>Scan to import</h3>
    <p class="muted">Open your VPN client app and scan this code.</p>
    <div class="modal-qr" id="qr-canvas"></div>
    <div class="modal-actions">
      <button type="button" class="btn" onclick="closeQr()">Close</button>
    </div>
  </div>
</div>

<div class="toast" id="copy-toast" role="status" aria-live="polite">Copied to clipboard</div>
<script>
  function copyLink(elementId) {
    const text = document.getElementById(elementId).textContent;
    navigator.clipboard.writeText(text).then(function () {
      const toast = document.getElementById('copy-toast');
      toast.classList.add('show');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(function () { toast.classList.remove('show'); }, 1800);
    });
  }

  // Keyboard support for elements made focusable via role="button"
  // (the copyable code/link boxes above) -- Enter/Space triggers the
  // same click handler a mouse click would.
  document.addEventListener('keydown', function (e) {
    if ((e.key === 'Enter' || e.key === ' ') && e.target.matches('[role="button"]')) {
      e.preventDefault();
      e.target.click();
    }
  });

  let qrInstance = null;
  function showQr(elementId) {
    const text = document.getElementById(elementId).textContent;
    const holder = document.getElementById('qr-canvas');
    holder.innerHTML = '';
    qrInstance = new QRCode(holder, {
      text: text,
      width: 220,
      height: 220,
      colorDark: '#0a0f1a',
      colorLight: '#ffffff',
      correctLevel: QRCode.CorrectLevel.M,
    });
    document.getElementById('qr-modal').classList.add('open');
  }
  function closeQr() {
    document.getElementById('qr-modal').classList.remove('open');
  }
</script>
<%- include('partials/footer') %>
