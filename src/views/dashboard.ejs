<%- include('partials/header', { title: 'Inbounds', loggedIn: loggedIn, csrfToken: csrfToken }) %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<div class="container">
  <div class="page-header">
    <h1>Inbounds</h1>
  </div>

  <div class="card">
    <p class="muted" style="margin-top:0;">
      One VLESS+REALITY config is auto-generated for every supported
      transport/ALPN combination, all sharing the same client identity.
      Enter your Railway TCP Proxy host once here (it's the same for
      every proxy on this service), then add a TCP Proxy per inbound
      below and fill in just its port.
    </p>
    <form method="POST" action="/settings/host" class="form-row">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div style="flex:1;">
        <label style="margin-top:0;">Railway TCP Proxy host</label>
        <input type="text" name="externalHost" placeholder="e.g. roundhouse.proxy.rlwy.net" value="<%= externalHost || '' %>" required />
      </div>
      <button type="submit" class="btn" style="height:41px;">Save</button>
    </form>

    <div style="margin-top:14px;">
      <label style="margin-top:0;">Subscription link (all configs)</label>
      <div class="link-box">
        <code id="sub-all" class="muted" title="Click to copy" onclick="copyLink('sub-all')"><%= subLink %></code>
        <button type="button" class="btn btn-small qr-icon-btn" title="Show QR" onclick="showQr('sub-all')"><%- qrIconSvg %></button>
      </div>
    </div>
  </div>

  <% inbounds.forEach((inbound) => { %>
      <div class="card">
        <div class="page-header" style="margin-bottom:14px;">
          <div>
            <h2 style="margin-bottom:4px;"><%= inbound.label %></h2>
            <p class="muted" style="margin:0;">
              VLESS · REALITY · fp=<%= inbound.fingerprint %> · internal port <%= inbound.internalPort %>
            </p>
          </div>
        </div>

        <form method="POST" action="/inbounds/<%= inbound.id %>/port" class="form-row">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div style="width:140px;">
            <label style="margin-top:0;">Port</label>
            <input type="text" name="externalPort" placeholder="e.g. 21012" value="<%= inbound.external_port || '' %>" required />
          </div>
          <button type="submit" class="btn" style="height:41px;">Save</button>
        </form>

        <div style="margin-top:14px;">
          <label style="margin-top:0;">Client link</label>
          <% if (inbound.link) { %>
            <div class="link-box">
              <code id="link-<%= inbound.id %>" title="Click to copy" onclick="copyLink('link-<%= inbound.id %>')"><%= inbound.link %></code>
              <button type="button" class="btn btn-small qr-icon-btn" title="Show QR" onclick="showQr('link-<%= inbound.id %>')"><%- qrIconSvg %></button>
            </div>
          <% } else { %>
            <p class="muted" style="margin-top:6px;">Set the host above and this inbound's port to activate its link.</p>
          <% } %>
          <p class="muted mono" style="margin-top:10px; margin-bottom:0;">&uarr;<%= formatBytes(inbound.up_bytes) %> &darr;<%= formatBytes(inbound.down_bytes) %></p>
        </div>
      </div>
  <% }) %>
</div>

<div class="modal-backdrop" id="qr-modal" onclick="if(event.target===this) closeQr()">
  <div class="modal-box">
    <h3>Scan to import</h3>
    <p class="muted">Open your VPN client app and scan this code.</p>
    <div class="modal-qr" id="qr-canvas"></div>
    <div class="modal-actions">
      <button type="button" class="btn" onclick="closeQr()">Close</button>
    </div>
  </div>
</div>

<div class="toast" id="copy-toast">Copied to clipboard</div>
<script>
  function copyLink(elementId) {
    const text = document.getElementById(elementId).textContent;
    navigator.clipboard.writeText(text).then(function () {
      const toast = document.getElementById('copy-toast');
      toast.classList.add('show');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(function () { toast.classList.remove('show'); }, 1800);
    });
  }

  let qrInstance = null;
  function showQr(elementId) {
    const text = document.getElementById(elementId).textContent;
    const holder = document.getElementById('qr-canvas');
    holder.innerHTML = '';
    qrInstance = new QRCode(holder, {
      text: text,
      width: 220,
      height: 220,
      colorDark: '#0a0f1a',
      colorLight: '#ffffff',
      correctLevel: QRCode.CorrectLevel.M,
    });
    document.getElementById('qr-modal').classList.add('open');
  }
  function closeQr() {
    document.getElementById('qr-modal').classList.remove('open');
  }
</script>
<%- include('partials/footer') %>
