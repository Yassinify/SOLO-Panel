<%- include('partials/header', { title: 'Inbounds', loggedIn: loggedIn, csrfToken: csrfToken }) %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<div class="container">
  <div class="page-header">
    <h1>Inbounds</h1>
  </div>

  <% if (dataDirWarning) { %>
    <div class="card" style="border-color: var(--danger);">
      <p style="margin:0;"><strong>⚠️ Persistent storage isn't configured.</strong> Without a Railway Volume, your admin password, generated links, and settings will be deleted on every redeploy. To fix this: in your Railway service go to <strong>Settings → Volumes</strong>, create a Volume and mount it (e.g. at <code>/app/data</code>), then set the <code>DATA_DIR</code> variable under <strong>Variables</strong> to that same path and redeploy.</p>
    </div>
  <% } %>

  <% if (modesUpdated) { %>
    <div class="card" style="border-color: var(--accent);">
      <p style="margin:0;"><strong>Mode changes applied.</strong> Please update your subscription in your client app so it picks up the new set of links.</p>
    </div>
  <% } %>

  <% if (limitsUpdated) { %>
    <div class="card" style="border-color: var(--accent);">
      <p style="margin:0;"><strong>Limits updated.</strong></p>
    </div>
  <% } %>

  <% if (modesError) { %>
    <div class="card" style="border-color: var(--danger);">
      <p style="margin:0;"><strong>Couldn't apply mode changes.</strong> At least one option must stay enabled in each section (<%= modesError.map((d) => d.charAt(0).toUpperCase() + d.slice(1)).join(', ') %>). No changes were made.</p>
    </div>
  <% } %>

  <div class="card">
    <div class="page-header" style="margin-bottom:14px;">
      <div>
        <h2 style="margin-bottom:4px;">System <span class="health-badge health-<%= systemStatus %>"><%= systemStatus %></span></h2>
        <p class="muted" style="margin:0;"><%= activeCount %> / <%= totalCount %> endpoints active</p>
        <p class="muted" style="margin:4px 0 0;">📅 <%= daysLeftText %>&nbsp;&nbsp;📊 <%= usageLeftText %></p>
      </div>
    </div>
    <p class="muted" style="margin-top:0;">
      Every combination of protocol, transport, ALPN, and TLS
      fingerprint is auto-generated automatically -- nothing to set up.
      All of them ride Railway's single HTTPS domain (<%= externalHost %>:443).
      Share the Subscription URL below: opened in a browser it shows a
      friendly overview page, and pasted into a client app it imports
      every config at once -- same link either way.
    </p>
    <div>
      <label style="margin-top:0;">Subscription URL</label>
      <div class="link-box">
        <code id="sub-all" class="muted" tabindex="0" role="button" aria-label="Copy subscription URL to clipboard" title="Click to copy" onclick="copyLink('sub-all')"><%= subLink %></code>
        <button type="button" class="btn btn-small qr-icon-btn" title="Show QR" aria-label="Show QR code for subscription link" onclick="showQr('sub-all')"><%- qrIconSvg %></button>
      </div>
    </div>
  </div>

  <details class="card">
    <summary class="muted" style="cursor:pointer; font-weight:600;">Time &amp; usage limits</summary>
    <p class="muted" style="margin-top:14px;">
      Optionally cap this subscription to a number of days and/or a
      total data amount. Leave a field blank for unlimited (the
      default). Saving restarts the countdown from now.
    </p>
    <form method="POST" action="/settings/limits">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Days</label>
      <input type="number" name="days" min="1" step="1" placeholder="Unlimited" value="<%= limitDays %>" style="margin-bottom:12px;">
      <label>Usage limit (GB)</label>
      <input type="number" name="usage_gb" min="0.01" step="0.01" placeholder="Unlimited" value="<%= limitUsageGB %>">
      <button type="submit" class="btn btn-accent" style="margin-top:16px;">Save Limits</button>
    </form>
  </details>

  <div class="card">
    <h2 style="margin-bottom:4px;">Advanced: modes</h2>
    <p class="muted" style="margin-top:0;">
      Turn individual modes off if you don't want them offered at all.
      Everything is on by default. Each section needs at least one
      option enabled at all times. Applying changes restarts the
      affected proxy engines, so give it a few seconds, then update
      your subscription in your client app.
    </p>
    <form method="POST" action="/settings/modes" onsubmit="return confirm('Apply mode changes? Affected proxy engines will restart, and you will need to update your subscription afterwards.');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% Object.entries(modeDimensions).forEach(([dimension, values]) => { %>
        <label style="text-transform: capitalize;"><%= dimension %></label>
        <div class="mode-grid">
          <% values.forEach((value) => { %>
            <label class="mode-toggle">
              <input type="checkbox" name="<%= dimension %>_<%= value %>" data-dimension="<%= dimension %>" <%= modeState[dimension][value] ? 'checked' : '' %>>
              <%= labelForMode(dimension, value) %>
            </label>
          <% }) %>
        </div>
      <% }) %>
      <button type="submit" class="btn btn-accent" style="margin-top:16px;">Apply Changes</button>
    </form>
  </div>
</div>

<div class="modal-backdrop" id="qr-modal" onclick="if(event.target===this) closeQr()">
  <div class="modal-box">
    <h3>Scan to import</h3>
    <p class="muted">Open your VPN client app and scan this code.</p>
    <div class="modal-qr" id="qr-canvas"></div>
    <div class="modal-actions">
      <button type="button" class="btn" onclick="closeQr()">Close</button>
    </div>
  </div>
</div>

<div class="toast" id="copy-toast" role="status" aria-live="polite">Copied to clipboard</div>
<script>
  function copyLink(elementId) {
    const text = document.getElementById(elementId).textContent;
    navigator.clipboard.writeText(text).then(function () {
      const toast = document.getElementById('copy-toast');
      toast.classList.add('show');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(function () { toast.classList.remove('show'); }, 1800);
    });
  }

  // Keyboard support for elements made focusable via role="button"
  // (the copyable code/link boxes above) -- Enter/Space triggers the
  // same click handler a mouse click would.
  document.addEventListener('keydown', function (e) {
    if ((e.key === 'Enter' || e.key === ' ') && e.target.matches('[role="button"]')) {
      e.preventDefault();
      e.target.click();
    }
  });

  // Mode toggles: block unchecking the last remaining checked option
  // within a dimension (e.g. Core, Protocol) client-side, mirroring
  // the server-side check in POST /settings/modes -- a dimension must
  // always keep at least one option enabled.
  document.querySelectorAll('.mode-toggle input[type="checkbox"]').forEach(function (checkbox) {
    checkbox.addEventListener('change', function () {
      if (this.checked) return;
      var dimension = this.dataset.dimension;
      var groupInputs = document.querySelectorAll('input[type="checkbox"][data-dimension="' + dimension + '"]');
      var anyStillChecked = Array.prototype.some.call(groupInputs, function (input) { return input.checked; });
      if (!anyStillChecked) {
        this.checked = true;
        alert('At least one option must stay enabled in this section.');
      }
    });
  });

  let qrInstance = null;
  function showQr(elementId) {
    const text = document.getElementById(elementId).textContent;
    const holder = document.getElementById('qr-canvas');
    holder.innerHTML = '';
    qrInstance = new QRCode(holder, {
      text: text,
      width: 220,
      height: 220,
      colorDark: '#0a0f1a',
      colorLight: '#ffffff',
      correctLevel: QRCode.CorrectLevel.M,
    });
    document.getElementById('qr-modal').classList.add('open');
  }
  function closeQr() {
    document.getElementById('qr-modal').classList.remove('open');
  }
</script>
<%- include('partials/footer') %>
