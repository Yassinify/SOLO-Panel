<%- include('partials/header', { loggedIn: loggedIn, csrfToken: csrfToken }) %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<div class="container">
  <% if (dataDirWarning) { %>
    <div class="card card-danger">
      <p style="margin:0 0 10px;"><strong>⚠️ Persistent storage isn't configured.</strong> Without a Railway Volume, your admin password, generated links, and settings will be deleted on every redeploy.</p>
      <p style="margin:0 0 6px; font-weight:600;">To fix this, attach a Volume to this service:</p>
      <ol class="step-list">
        <li><code>⌘K</code> / <code>Ctrl+K</code> (Command Palette) → search “volume” → <strong>New Volume</strong></li>
        <li>or right-click the service on the project canvas → <strong>Attach Volume</strong> / <strong>New Volume</strong></li>
      </ol>
      <p class="muted" style="margin:0;">Any mount path works (e.g. <code>/app/data</code>) — the panel detects it automatically. Redeploy afterward.</p>
    </div>
  <% } %>

  <% if (modesError) { %>
    <div class="card card-danger">
      <p style="margin:0;"><strong>Couldn't apply mode changes.</strong> At least one option must stay enabled in each section (<%= modesError.map((d) => d.charAt(0).toUpperCase() + d.slice(1)).join(', ') %>). No changes were made.</p>
    </div>
  <% } %>

  <% if (pwError) { %>
    <div class="card card-danger">
      <p style="margin:0;"><strong><%= pwError === 'current' ? 'Current password is incorrect.' : pwError === 'mismatch' ? "New password and confirmation don't match." : 'New password must be at least 4 characters.' %></strong></p>
    </div>
  <% } %>
  <% if (pwSuccess) { %>
    <div class="card" style="border-color: var(--accent);">
      <p style="margin:0;"><strong>Password changed successfully.</strong></p>
    </div>
  <% } %>

  <div class="card">
    <label class="sub-header-row">
      <span>Subscription URL</span>
      <% if (location.iso2) { %>
        <img class="location-flag" src="https://flagcdn.com/24x18/<%= location.iso2 %>.png" srcset="https://flagcdn.com/48x36/<%= location.iso2 %>.png 2x" width="24" height="18" alt="<%= location.name %> flag" style="display:block; border-radius:2px; flex-shrink:0;">
      <% } else { %>
        <span><%= location.flag %></span>
      <% } %>
    </label>
    <div class="link-box">
      <code id="sub-all" class="muted" tabindex="0" role="button" aria-label="Copy subscription URL to clipboard" title="Click to copy" onclick="copyLink('sub-all')"><%= subLink %></code>
      <button type="button" class="btn btn-small qr-icon-btn" title="Show QR" aria-label="Show QR code for subscription link" onclick="showQr('sub-all')"><%- qrIconSvg %></button>
    </div>
  </div>

  <div class="card">

    <form method="POST" action="/settings/advanced" id="advancedForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <h3 style="margin-bottom:4px;">Modes</h3>
      <% Object.entries(modeDimensions).forEach(([dimension, values]) => { %>
        <label style="text-transform: capitalize;"><%= dimension %></label>
        <div class="mode-grid">
          <% values.forEach((value) => { %>
            <label class="mode-toggle<%= modeState[dimension][value] ? ' selected' : '' %>">
              <input type="checkbox" name="<%= dimension %>_<%= value %>" data-dimension="<%= dimension %>" <%= modeState[dimension][value] ? 'checked' : '' %>>
              <%= labelForMode(dimension, value) %>
            </label>
          <% }) %>
        </div>
      <% }) %>

      <hr class="section-divider">

      <h3 style="margin-bottom:4px;">Time &amp; usage limits</h3>
      <div class="form-row">
        <div style="flex:1; min-width:140px;">
          <label>End date</label>
          <button type="button" class="date-trigger" id="endDateTrigger" onclick="openCalendar()">
            <span id="endDateLabel">Unlimited</span>
            <svg class="date-trigger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          </button>
          <input type="hidden" name="end_date" id="endDateInput" value="<%= limitEndDate %>">
        </div>
        <div style="flex:1; min-width:140px;">
          <label>Usage limit (GB)</label>
          <input type="number" name="usage_gb" min="0.01" step="0.01" placeholder="Unlimited" value="<%= limitUsageGB %>">
        </div>
      </div>

      <button type="submit" id="applyBtn" class="btn btn-apply btn-block" style="margin-top:16px;" disabled>Apply Changes</button>
    </form>
  </div>
</div>

<div class="modal-backdrop" id="confirm-modal" onclick="if(event.target===this) closeConfirmModal()">
  <div class="modal-box">
    <h3>Apply changes?</h3>
    <p class="muted">This saves your mode selections and time/usage limits. If any mode changed, affected proxy engines will restart and you'll need to update your subscription in your client app afterwards.</p>
    <div class="modal-actions">
      <button type="button" class="btn" onclick="closeConfirmModal()">Cancel</button>
      <button type="button" class="btn btn-apply" onclick="confirmApply()">Apply Changes</button>
    </div>
  </div>
</div>

<div class="modal-backdrop" id="password-modal" onclick="if(event.target===this) closePasswordModal()">
  <div class="modal-box">
    <h3>Change Password</h3>
    <form method="POST" action="/settings/password">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label style="text-align:left;">Current password</label>
      <input type="password" name="current_password" required autocomplete="current-password">
      <label style="text-align:left;">New password</label>
      <input type="password" name="new_password" required minlength="4" autocomplete="new-password">
      <label style="text-align:left;">Confirm new password</label>
      <input type="password" name="confirm_password" required minlength="4" autocomplete="new-password">
      <div class="modal-actions" style="margin-top:16px;">
        <button type="button" class="btn" onclick="closePasswordModal()">Cancel</button>
        <button type="submit" class="btn btn-accent">Change Password</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-backdrop" id="qr-modal" onclick="if(event.target===this) closeQr()">
  <div class="modal-box">
    <h3>Scan to import</h3>
    <p class="muted">Open your VPN client app and scan this code.</p>
    <div class="modal-qr" id="qr-canvas"></div>
    <div class="modal-actions">
      <button type="button" class="btn" onclick="closeQr()">Close</button>
    </div>
  </div>
</div>

<div class="modal-backdrop" id="calendar-modal" onclick="if(event.target===this) closeCalendar()">
  <div class="modal-box calendar-box">
    <div class="calendar-header">
      <button type="button" class="calendar-nav-btn" id="calPrevBtn" onclick="calendarNav(-1)" aria-label="Previous month">&#8249;</button>
      <span class="calendar-title" id="calendarTitle"></span>
      <button type="button" class="calendar-nav-btn" onclick="calendarNav(1)" aria-label="Next month">&#8250;</button>
    </div>
    <div class="calendar-weekdays">
      <span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span>
    </div>
    <div class="calendar-grid" id="calendarGrid"></div>
    <div class="modal-actions">
      <button type="button" class="btn" onclick="selectUnlimited()">Unlimited</button>
      <button type="button" class="btn" onclick="closeCalendar()">Cancel</button>
    </div>
  </div>
</div>

<div class="toast" id="copy-toast" role="status" aria-live="polite">Copied to clipboard</div>
<script>
  function copyLink(elementId) {
    const text = document.getElementById(elementId).textContent;
    navigator.clipboard.writeText(text).then(function () {
      const toast = document.getElementById('copy-toast');
      toast.classList.add('show');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(function () { toast.classList.remove('show'); }, 1800);
    });
  }

  // Keyboard support for elements made focusable via role="button"
  // (the copyable code/link boxes above) -- Enter/Space triggers the
  // same click handler a mouse click would.
  document.addEventListener('keydown', function (e) {
    if ((e.key === 'Enter' || e.key === ' ') && e.target.matches('[role="button"]')) {
      e.preventDefault();
      e.target.click();
    }
  });

  // Mode toggles: block unchecking the last remaining checked option
  // within a dimension (e.g. Protocol, Transport) client-side, mirroring
  // the server-side check in POST /settings/advanced -- a dimension
  // must always keep at least one option enabled. Also keeps the
  // chip's .selected class (its accent-colored background) in sync
  // with the checkbox's actual checked state, and re-evaluates
  // whether the Apply Changes button should be enabled (see below).
  var advancedForm = document.getElementById('advancedForm');
  var modeCheckboxes = Array.prototype.slice.call(document.querySelectorAll('.mode-toggle input[type="checkbox"]'));
  var limitInputs = Array.prototype.slice.call(advancedForm.querySelectorAll('input[type="number"]')).concat([document.getElementById('endDateInput')]);

  // Snapshot of the whole form (mode checkboxes + the two limit
  // fields) as loaded from the server, used to detect whether the
  // admin has actually changed anything -- Apply Changes starts
  // disabled and only becomes clickable once the current form state
  // differs from this snapshot (not on every click/keystroke).
  function formSignature() {
    var modesPart = modeCheckboxes
      .filter(function (cb) { return cb.checked; })
      .map(function (cb) { return cb.name; })
      .sort()
      .join(',');
    var limitsPart = limitInputs.map(function (input) { return input.name + '=' + input.value; }).join('&');
    return modesPart + '|' + limitsPart;
  }
  var initialFormSignature = formSignature();
  var applyBtn = document.getElementById('applyBtn');
  function refreshApplyButton() {
    applyBtn.disabled = formSignature() === initialFormSignature;
  }

  modeCheckboxes.forEach(function (checkbox) {
    checkbox.addEventListener('change', function () {
      var chip = this.closest('.mode-toggle');
      if (!this.checked) {
        var dimension = this.dataset.dimension;
        var groupInputs = document.querySelectorAll('input[type="checkbox"][data-dimension="' + dimension + '"]');
        var anyStillChecked = Array.prototype.some.call(groupInputs, function (input) { return input.checked; });
        if (!anyStillChecked) {
          this.checked = true;
          alert('At least one option must stay enabled in this section.');
          refreshApplyButton();
          return;
        }
      }
      chip.classList.toggle('selected', this.checked);
      refreshApplyButton();
    });
  });

  limitInputs.forEach(function (input) {
    input.addEventListener('input', refreshApplyButton);
  });

  // Custom calendar date picker (End date field) -- reuses the same
  // .modal-backdrop/.modal-box pattern as the QR/confirm modals above
  // instead of a floating popover, so it's responsive for free.
  var todayDateStr = '<%= todayDate %>';
  var endDateInput = document.getElementById('endDateInput');
  var endDateLabel = document.getElementById('endDateLabel');
  var calendarTitle = document.getElementById('calendarTitle');
  var calendarGrid = document.getElementById('calendarGrid');
  var calPrevBtn = document.getElementById('calPrevBtn');
  var MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  var calendarViewYear, calendarViewMonth;

  function parseDateStr(str) {
    var parts = str.split('-').map(Number);
    return new Date(parts[0], parts[1] - 1, parts[2]);
  }
  function formatDateStr(year, month, day) {
    return year + '-' + String(month + 1).padStart(2, '0') + '-' + String(day).padStart(2, '0');
  }
  function updateTriggerLabel() {
    endDateLabel.textContent = endDateInput.value
      ? parseDateStr(endDateInput.value).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })
      : 'Unlimited';
  }
  updateTriggerLabel();

  function openCalendar() {
    var base = parseDateStr(endDateInput.value || todayDateStr);
    calendarViewYear = base.getFullYear();
    calendarViewMonth = base.getMonth();
    renderCalendar();
    document.getElementById('calendar-modal').classList.add('open');
  }
  function closeCalendar() {
    document.getElementById('calendar-modal').classList.remove('open');
  }
  function calendarNav(delta) {
    calendarViewMonth += delta;
    if (calendarViewMonth < 0) { calendarViewMonth = 11; calendarViewYear--; }
    if (calendarViewMonth > 11) { calendarViewMonth = 0; calendarViewYear++; }
    renderCalendar();
  }
  function renderCalendar() {
    calendarTitle.textContent = MONTH_NAMES[calendarViewMonth] + ' ' + calendarViewYear;
    var today = parseDateStr(todayDateStr);
    var todayYear = today.getFullYear();
    var todayMonth = today.getMonth();
    calPrevBtn.disabled = calendarViewYear < todayYear || (calendarViewYear === todayYear && calendarViewMonth <= todayMonth);

    var firstDay = new Date(calendarViewYear, calendarViewMonth, 1).getDay();
    var daysInMonth = new Date(calendarViewYear, calendarViewMonth + 1, 0).getDate();
    var html = '';
    for (var i = 0; i < firstDay; i++) {
      html += '<span class="calendar-day calendar-day-empty"></span>';
    }
    for (var day = 1; day <= daysInMonth; day++) {
      var dateStr = formatDateStr(calendarViewYear, calendarViewMonth, day);
      var isPast = dateStr < todayDateStr;
      var classes = 'calendar-day';
      if (dateStr === todayDateStr) classes += ' calendar-day-today';
      if (dateStr === endDateInput.value) classes += ' calendar-day-selected';
      html += '<button type="button" class="' + classes + '"' + (isPast ? ' disabled' : ' onclick="selectDate(\'' + dateStr + '\')"') + '>' + day + '</button>';
    }
    calendarGrid.innerHTML = html;
  }
  function selectDate(dateStr) {
    endDateInput.value = dateStr;
    updateTriggerLabel();
    closeCalendar();
    refreshApplyButton();
  }
  function selectUnlimited() {
    endDateInput.value = '';
    updateTriggerLabel();
    closeCalendar();
    refreshApplyButton();
  }

  // Confirmation is a panel-styled modal (matching the QR modal),
  // not a native browser confirm() popup. Submitting the form opens
  // the modal instead of posting immediately; the modal's own Apply
  // Changes button does the actual form.submit() (which -- unlike a
  // dispatched 'submit' event -- doesn't re-trigger this listener, so
  // there's no loop).
  advancedForm.addEventListener('submit', function (e) {
    e.preventDefault();
    document.getElementById('confirm-modal').classList.add('open');
  });
  function confirmApply() {
    document.getElementById('confirm-modal').classList.remove('open');
    advancedForm.submit();
  }
  function closeConfirmModal() {
    document.getElementById('confirm-modal').classList.remove('open');
  }

  function openPasswordModal() {
    document.getElementById('password-modal').classList.add('open');
  }
  function closePasswordModal() {
    document.getElementById('password-modal').classList.remove('open');
  }

  function showQr(elementId) {
    const text = document.getElementById(elementId).textContent;
    const holder = document.getElementById('qr-canvas');
    holder.innerHTML = '';
    // Result isn't kept -- holder.innerHTML is cleared above instead
    // of calling QRCode's own .clear()/.makeCode() on a stored instance.
    new QRCode(holder, {
      text: text,
      width: 220,
      height: 220,
      colorDark: '#0a0f1a',
      colorLight: '#ffffff',
      correctLevel: QRCode.CorrectLevel.M,
    });
    document.getElementById('qr-modal').classList.add('open');
  }
  function closeQr() {
    document.getElementById('qr-modal').classList.remove('open');
  }
</script>
<%- include('partials/footer') %>
