<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>SOLO Panel - <%= appVersion %></title>
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=<%= appVersion %>" />
</head>
<body>
<% if (typeof loggedIn !== 'undefined' && loggedIn) { %>
  <div class="topbar">
    <div class="topbar-side"></div>
    <div class="brand-wrap">
      <a href="/" class="brand brand-center">SOLO<span>Panel</span></a>
      <div class="brand-version">v<%= appVersion %></div>
    </div>
    <div class="topbar-side topbar-user">
      <form class="inline" method="POST" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="btn btn-small">Log out</button>
      </form>
    </div>
  </div>
<% } %>
