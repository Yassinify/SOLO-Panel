<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>SOLO Panel - <%= appVersion %></title>
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=<%= appVersion %>" />
</head>
<body>
  <div class="topbar">
    <div class="topbar-side">
      <a href="https://github.com/Yassinify/SOLO-Panel" target="_blank" rel="noopener noreferrer" class="github-link" aria-label="View SOLO Panel on GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="github-link-svg" aria-hidden="true">
          <path fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
      </a>
    </div>
    <div class="brand-wrap">
      <a href="/" class="brand brand-center">SOLO<span>Panel</span></a>
      <div class="brand-version">v<%= appVersion %></div>
    </div>
    <div class="topbar-side topbar-user">
    <% if (typeof loggedIn !== 'undefined' && loggedIn) { %>
      <div class="profile-menu" id="profile-menu">
        <button type="button" class="profile-trigger" id="profile-trigger-btn" onclick="toggleProfileMenu()" aria-haspopup="true" aria-expanded="false" aria-label="Account menu">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="profile-trigger-svg" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
          </svg>
        </button>
        <div class="profile-dropdown" id="profile-dropdown" role="menu">
          <button type="button" class="profile-dropdown-item" role="menuitem" onclick="closeProfileMenu(); openPasswordModal();">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="profile-dropdown-icon" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
            </svg>
            <span>Change Password</span>
          </button>
          <form class="profile-dropdown-form" method="POST" action="/logout">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="profile-dropdown-item" role="menuitem">
              <svg data-component="Octicon" aria-hidden="true" focusable="false" class="profile-dropdown-icon" viewBox="0 0 16 16" fill="currentColor"><path d="M2 2.75C2 1.784 2.784 1 3.75 1h2.5a.75.75 0 0 1 0 1.5h-2.5a.25.25 0 0 0-.25.25v10.5c0 .138.112.25.25.25h2.5a.75.75 0 0 1 0 1.5h-2.5A1.75 1.75 0 0 1 2 13.25Zm10.44 4.5-1.97-1.97a.749.749 0 0 1 .326-1.275.749.749 0 0 1 .734.215l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734l1.97-1.97H6.75a.75.75 0 0 1 0-1.5Z"></path></svg>
              <span>Sign out</span>
            </button>
          </form>
        </div>
      </div>
      <div class="profile-menu-overlay" id="profile-menu-overlay"></div>
    <% } %>
    </div>
  </div>
  <% if (typeof loggedIn !== 'undefined' && loggedIn) { %>
  <script>
    function toggleProfileMenu() {
      var dropdown = document.getElementById('profile-dropdown');
      var trigger = document.getElementById('profile-trigger-btn');
      var overlay = document.getElementById('profile-menu-overlay');
      var isOpen = dropdown.classList.toggle('open');
      overlay.classList.toggle('open', isOpen);
      trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    }
    function closeProfileMenu() {
      document.getElementById('profile-dropdown').classList.remove('open');
      document.getElementById('profile-menu-overlay').classList.remove('open');
      document.getElementById('profile-trigger-btn').setAttribute('aria-expanded', 'false');
    }
    document.addEventListener('click', function (e) {
      var menu = document.getElementById('profile-menu');
      if (menu && !menu.contains(e.target)) closeProfileMenu();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeProfileMenu();
    });
  </script>
  <% } %>
