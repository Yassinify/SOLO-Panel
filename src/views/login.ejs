<%- include('partials/header', { loggedIn: false }) %>
<div class="login-shell">
  <div class="card login-card">
    <h1 class="brand" style="margin-bottom:4px; font-size:26px;">SOLO<span>Panel</span></h1>
    <p class="muted" style="margin:0 0 20px;">Sign in to manage your panel.</p>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <form method="POST" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label>Password</label>
      <input type="password" name="password" required autofocus />
      <button type="submit" class="btn btn-accent" style="width:100%; margin-top:20px;">Log in</button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
