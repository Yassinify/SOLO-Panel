# Copy this to .env for local dev (not used on Railway — set these as
# Railway service Variables instead, in the dashboard).

# Password for the single admin account (no username, password-only
# login). Created automatically on first boot if no admin exists yet.
# OPTIONAL — if unset, defaults to "admin". Change this before
# deploying anywhere public.
# ADMIN_PASSWORD=admin

# Secret used to sign session cookies. OPTIONAL — if unset, the panel
# generates a random one on first boot and stores it in the database,
# so you don't have to come up with one yourself. Only set this
# manually if you want a specific value (e.g. to share one secret
# across multiple instances).
# SESSION_SECRET=replace-with-a-real-random-value

# Where SQLite data (panel.db, generated xray config, and the
# auto-generated SESSION_SECRET above) is stored. OPTIONAL — defaults
# to ./data. On Railway, attach a Volume to the service and set this
# to its mount path (e.g. /data), or all data is lost on every
# redeploy.
# DATA_DIR=./data

# Pinned xray-core release downloaded by scripts/install-xray.js.
# OPTIONAL — if unset, the install script automatically looks up and
# uses whatever XTLS/Xray-core's actual latest stable release is at
# install time. Set this only if you want to pin a specific version.
# XRAY_VERSION=v26.3.27
