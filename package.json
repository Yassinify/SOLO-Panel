{
  "name": "solo-panel",
  "version": "1.2.3",
  "description": "Node.js web panel for managing Xray-core inbounds, deployable on Railway.com",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "postinstall": "node scripts/install-xray.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ejs": "^6.0.1",
    "better-sqlite3": "^11.3.0",
    "express-session": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "adm-zip": "^0.6.0"
  },
  "allowScripts": {
    "better-sqlite3": true
  },
  "overrides": {
    "body-parser": "^1.20.6"
  }
}
